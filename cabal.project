-- run `nix flake lock --update-input hackage` after updating index-state.
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- See CONTRIBUTING for information about these, including some Nix commands
-- you need to run if you change them
index-state:
  , hackage.haskell.org 2026-05-27T06:20:37Z
  , cardano-haskell-packages 2026-06-01T00:05:45Z

active-repositories:
  , :rest
  , cardano-haskell-packages:override

packages:
  cardano-faucet

allow-newer:
  *:aeson,
  monoidal-containers:aeson,
  size-based:template-haskell,
  attoparsec,
  text,
  io-sim:time,
  io-classes:time

constraints:
  , any.crypton-x509-system < 1.6.8

test-show-details: direct

package cryptonite
  -- Using RDRAND instead of /dev/urandom as an entropy source for key
  -- generation is dubious. Set the flag so we use /dev/urandom by default.
  flags: -support_rdrand

package snap-server
  flags: +openssl

package comonad
  flags: -test-doctests

if os(windows)
  -- Avoid `unknown symbol __cpu_model` when cross compilation runs TH code
  package bitvec
    flags: -simd

-- Temporary: Leios prototype branches — Dijkstra era support not yet in CHaP releases.
-- Pins match https://github.com/IntersectMBO/cardano-node/blob/24186acacb7b607c776088b5df68b0c235aac603/cabal.project
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/ouroboros-consensus
  tag: d941d06ef8bbb35fd369c09c1d9d76c20b561969
  --sha256: sha256-XsxbYo41B71lb42/+1QnSRb0S98G8cKYqWWiLlNd32c=

source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-ledger
  tag: 4bf2edca4ccbf18d4e2574b1544a2cf7ffc992eb
  --sha256: sha256-rFFN26bjo0Wji9htl5Bj5Et7m3FsREv72vdP91fo8+o=
  subdir:
    libs/cardano-ledger-core
    eras/dijkstra/impl

source-repository-package
  type: git
  location: https://github.com/IntersectMBO/ouroboros-network
  tag: ff3e39af5aa51d4d89c23c72d67716fd9bfcc516
  --sha256: sha256-Ctw/Vi8j9KyDtVm0NK+Jk0COtPi1kpL4lHfUF8/eCgI=
  subdir:
    ouroboros-network
    cardano-diffusion
    network-mux

source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-api
  tag: 8bfd8686434ab98e172476fa25c81c81ea9227a6
  --sha256: sha256-DDvLjygtEv9l/ktQuLF/CWFKpx2yE9VxcwMNIwXTKAM=
  subdir:
    cardano-api

-- IMPORTANT
-- Do NOT add more source-repository-package stanzas here unless they are strictly
-- temporary! Please read the section in CONTRIBUTING about returning dependencies to CHaP.
