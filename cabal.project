  location: https://github.com/IntersectMBO/cardano-ledger
  tag: c47305fcf47bd77437b837d0dfb9cb4181bfbc77
  --sha256: 1db2xc2gs44g5035srqzgqkbv3a2yacmvnwchd1jnjrfkibnxnak
  subdir:
    libs/cardano-ledger-core
